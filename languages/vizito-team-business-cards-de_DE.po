msgstr "E-Mail"

msgid "WhatsApp number"
msgstr "WhatsApp-Nummer"

msgid "Street and number"
msgstr "Straße und Hausnummer"

msgid "Postcode"
msgstr "Postleitzahl"

msgid "City"
msgstr "Ort"

msgid "Country"
msgstr "Land"

